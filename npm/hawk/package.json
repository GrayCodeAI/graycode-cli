{
    "name": "@graycodeai/hawk",
    "version": "0.0.0-development",
    "description": "Bring Hawk into your terminal",
    "license": "Apache-2.0",
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "cpu": [
        "arm64",
        "x64"
    ],
    "scripts": {
        "assemble": "node scripts/assemble-platform-packages.js",
        "postinstall": "node bin/postinstall.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    },
    "optionalDependencies": {
        "@graycodeai/hawk-darwin-arm64": "0.0.0-development",
        "@graycodeai/hawk-darwin-x64": "0.0.0-development",
        "@graycodeai/hawk-linux-arm64": "0.0.0-development",
        "@graycodeai/hawk-linux-x64": "0.0.0-development",
        "@graycodeai/hawk-win32-arm64": "0.0.0-development",
        "@graycodeai/hawk-win32-x64": "0.0.0-development"
    }
}
