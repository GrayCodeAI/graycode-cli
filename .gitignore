# Binaries
/hawk
# Ignore build output in bin/, but track committed source scripts like bin/buf.
bin/*
!bin/buf
hawk_bin
*.exe
*.dll
*.so

# Dev tool state
.claude/
.codegraph/
.commandcode/
.hawk/
.yaad/
.openclaude/
.grok/
.hermes/
.qoder/
.pi/

# Cache / local data
.gocache/
.gocache-*/
.gomodcache/
.gomodcache-*/
.golangci-cache/
.gopath/
.tmp/
*.codegraph.db
.DS_Store

# Test artifacts
coverage.out
coverage.html
CODE_REVIEW_REPORT.md
review_report.md

# Workspace checksum file — regenerated by `make setup` / `go work sync`;
# deleted and regenerated by the Dockerfile and flake.nix builds.
go.work.sum

# Lefthook-generated git hook wrappers
.githooks/
__pycache__/
hawk_bin

# Logs
*.log
hawk-sec105b.log
